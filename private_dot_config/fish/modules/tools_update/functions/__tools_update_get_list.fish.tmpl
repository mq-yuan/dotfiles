# ~/.config/fish/modules/tools_update/functions/__tools_update_get_list.fish

# This function is the Single Source of Truth for the tool list.
# It provides the configuration to both the main function and the completion script.
#
# Each tool is a 6-field tuple:
#   Name, Check Command, Update Command, Type, Sudo Required?, Aggressive Command
#
# Aggressive Command is used when `tools_update -A/--aggressive` is passed.
# Leave it as "" to fall back to the stable Update Command. System-level package
# managers (pacman/paru, apt, snap) intentionally leave aggressive_cmd empty —
# or use a conservative variant — so `-A` never escalates a host OS upgrade.
#
# OS tools are detected at render time via lookPath: only the package managers
# that actually exist on this host are emitted, so the same template serves
# CachyOS/Arch (pacman + paru), Ubuntu (apt + snap), and macOS (brew).
{{- /* rustup 安装方式共存：rustup-init 脚本安装落在 ~/.cargo/bin，支持
      `rustup self update`；发行版/Homebrew 构建（如 /usr/bin/rustup、
      /opt/homebrew/bin/rustup）禁用了 self-update，其二进制由各自包管理器
      升级，因此这里绝不能对其执行 `rustup self update`。 */ -}}
{{- $rustupAggressive := "" -}}
{{- $rustupPath := lookPath "rustup" -}}
{{- if $rustupPath -}}
{{-   if contains "/.cargo/" $rustupPath -}}
{{-     $rustupAggressive = "rustup self update && rustup update" -}}
{{-   else -}}
{{-     $rustupAggressive = "rustup update" -}}
{{-   end -}}
{{- end }}
function __tools_update_get_list
    set -l tools_common \
        "Fisher_Plugin"    "fisher"                       "fisher update"                                  "fish"     "no"   ""                                            \
        "Cargo_Update"     "cargo-install-update"         "cargo install-update --all"                     "language" "no"   "cargo install-update --all --git"            \
        "Rustup"           "rustup"                       "rustup update"                                  "language" "no"   {{ $rustupAggressive | quote }}                    \
        "UV_Tools"         "uv"                           "uv tool upgrade --all"                          "language" "no"   ""

    set -l tools_os
{{- if lookPath "brew" }}
    set -a tools_os "Homebrew" "brew" "brew update && brew upgrade" "user" "no" "brew update && brew upgrade --greedy"
{{- end }}
{{- if lookPath "pacman" }}
    set -a tools_os "Pacman" "pacman" "sudo pacman -Syu" "system" "yes" ""
{{- end }}
{{- if lookPath "paru" }}
    set -a tools_os "Paru_AUR" "paru" "paru -Sua" "system" "yes" "paru -Sua --devel"
{{- end }}
{{- if lookPath "apt" }}
    set -a tools_os "APT" "apt" "sudo apt update && sudo apt upgrade" "system" "yes" ""
{{- end }}
{{- if lookPath "snap" }}
    set -a tools_os "Snap" "snap" "sudo snap refresh" "system" "yes" ""
{{- end }}
{{- if lookPath "flatpak" }}
    set -a tools_os "Flatpak" "flatpak" {{ if and (hasKey . "proxyUrl") .proxyUrl }}"https_proxy={{ .proxyUrl }} http_proxy={{ .proxyUrl }} flatpak update -y"{{ else }}"flatpak update -y"{{ end }} "user" "no" ""
{{- end }}

    set -l tools $tools_common $tools_os

    # Output the entire list, one element per line.
    for item in $tools
        echo "$item"
    end
end
