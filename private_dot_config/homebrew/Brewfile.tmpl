# ~/.config/homebrew/Brewfile -- managed by chezmoi
# Source: private_dot_config/homebrew/Brewfile.tmpl  (edit the .tmpl, not the target)
#
# Installed automatically by .chezmoiscripts/run_onchange_after_10-brew-bundle.sh.tmpl
# on tag-bearing macOS hosts. Run it by hand anytime with:
#     brew bundle --file=~/.config/homebrew/Brewfile
#
# This file is macOS-only. Arch/CachyOS hosts install their packages via
# pacman/paru (see private_dot_config/pacman/pkglist.txt.tmpl), not Homebrew.

{{- $tags := list }}
{{- if hasKey . "tags" }}{{ $tags = .tags }}{{ end }}

# ---- Core CLI (every tagged Mac) ----
brew "neovim"
brew "tmux"        # heavy tmux config ships here; keep it explicit, not a transitive dep
brew "herdr"       # terminal agent multiplexer; config ships in ~/.config/herdr on every host
brew "direnv"      # universal: binary + fish hook ship on every host
brew "fd"
brew "fzf"
brew "ripgrep"
brew "lazygit"
brew "yazi"
brew "zoxide"
brew "gdu"
brew "uv"
brew "btop"
brew "fastfetch"
brew "jq"
brew "tree"

# Modern bash (macOS ships 3.2; some scripts assume 5.x)
brew "bash"

# CLI tools
brew "chezmoi"
brew "fish"
brew "fnm"
brew "poppler"
brew "resvg"
brew "sevenzip"
# whatcable-cli: cable info/lookup CLI from a third-party tap. Homebrew
# refuses formulae from untrusted taps; run_onchange_after_10-brew-bundle
# trusts this tap before `brew bundle`, so no manual step is needed.
tap "darrylmorley/whatcable"
brew "whatcable-cli"
# ffmpeg: yazi video thumbnails + general CLI use.
brew "ffmpeg"

# GUI apps & terminals
cask "ghostty"
cask "keepassxc"
cask "input-source-pro"

# AI coding tools
cask "claude-code@latest"
cask "codex"
cask "cmux"                    # Ghostty-based terminal for AI coding agents
cask "codexbar"                # menu bar usage monitor for Codex and Claude

# Utilities
cask "keka"                    # archive extraction / compression
cask "pearcleaner"             # app uninstaller / leftover-file cleaner
cask "thaw"                    # menu bar manager (requires macOS 26+)
# snapzy: screenshot tool. Its tap is non-official, so on a fresh machine run
# this once before `brew bundle` (brew bundle cannot trust a tap for you):
#   brew trust --cask duongductrong/snapzy/snapzy
tap "duongductrong/snapzy"
cask "snapzy"

# Fonts (terminal / icon rendering)
cask "font-maple-mono-nf-cn"
cask "font-symbols-only-nerd-font"

{{ if has "dev" $tags -}}
# ---- Dev-only (tagged "dev" on macOS) ----
# Heavy media / LaTeX / Lua toolchain a pure-entertainment Mac doesn't need.
brew "gh"          # GitHub CLI; only dev hosts talk to GitHub from the terminal
brew "cmake"       # C/C++ build system; dev hosts build from source
brew "imagemagick-full"
brew "luarocks"
brew "typst"                 # modern LaTeX alternative; dev machines only
cask "basictex"                # LaTeX distribution
cask "font-libertinus"         # scientific-plotting body font
{{ end -}}
