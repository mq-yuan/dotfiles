# CUDA / cuDNN / OptiX toolchain helpers for project .envrc files.
#
# Pin a project's toolchain with, e.g.:
#   use cuda 12.8
#   use optix 9.1
#
# Everything resolves under one base dir (default $HOME/cuda, override with
# CUDA_ROOT):
#   $CUDA_ROOT/cuda-<ver>/            CUDA toolkit
#   $CUDA_ROOT/cudnn-<ver>_cuda-<maj> cuDNN (newest matching the CUDA major)
#   $CUDA_ROOT/optix-<ver>/           OptiX SDK
#
# No sudo, no update-alternatives, no nvcc verification — direnv reloads on
# every cd, so these stay cheap. The host compiler is pinned via
# CC/CXX/CUDAHOSTCXX to the versioned gcc/g++ that ships with each CUDA
# release; the system default gcc is never modified. PATH / LD_LIBRARY_PATH /
# CPATH go through direnv's path helpers so they unwind on leaving the dir.

use_cuda() {
    local base="${CUDA_ROOT:-$HOME/cuda}"
    local target="${1:-12.8}"

    if [[ "$target" == "latest" ]]; then
        local latest_dir
        latest_dir="$(ls -d "$base"/cuda-* 2>/dev/null | sort -V | tail -n 1)"
        if [[ -z "$latest_dir" ]]; then
            log_error "use cuda: no CUDA toolkits found under $base"
            return 1
        fi
        target="$(basename "$latest_dir" | sed 's/^cuda-//')"
    fi

    local cuda_dir="$base/cuda-$target"
    if [[ ! -d "$cuda_dir" ]]; then
        log_error "use cuda: CUDA $target not found at $cuda_dir"
        return 1
    fi

    # Host compiler (gcc11/gcc13 from AUR on Arch). Keep the map in sync with
    # the fish `cuda` function. A missing compiler is a warning, not an error.
    local required_gcc=""
    case "$target" in
        11.8*) required_gcc=11 ;;
        12.*)  required_gcc=13 ;;
    esac
    if [[ -n "$required_gcc" && -x "/usr/bin/gcc-$required_gcc" ]]; then
        export CC="/usr/bin/gcc-$required_gcc"
        export CXX="/usr/bin/g++-$required_gcc"
        export CUDAHOSTCXX="/usr/bin/g++-$required_gcc"
    elif [[ -n "$required_gcc" ]]; then
        log_status "use cuda: gcc-$required_gcc not installed; host compiler untouched"
    fi

    export CUDA_HOME="$cuda_dir"
    PATH_add "$cuda_dir/bin"
    if [[ -d "$cuda_dir/lib64" ]]; then
        path_add LD_LIBRARY_PATH "$cuda_dir/lib64"
    elif [[ -d "$cuda_dir/lib" ]]; then
        path_add LD_LIBRARY_PATH "$cuda_dir/lib"
    fi

    # Newest cuDNN matching the CUDA major version.
    local cuda_major="${target%%.*}"
    local cudnn_dir
    cudnn_dir="$(ls -d "$base"/cudnn-*_cuda-"$cuda_major" 2>/dev/null | sort -V | tail -n 1)"
    if [[ -n "$cudnn_dir" ]]; then
        if [[ -d "$cudnn_dir/lib" ]]; then
            path_add LD_LIBRARY_PATH "$cudnn_dir/lib"
        elif [[ -d "$cudnn_dir/lib64" ]]; then
            path_add LD_LIBRARY_PATH "$cudnn_dir/lib64"
        fi
        [[ -d "$cudnn_dir/include" ]] && path_add CPATH "$cudnn_dir/include"
        log_status "use cuda: cuda $target + cudnn $(basename "$cudnn_dir" | sed -E 's/cudnn-(.*)_cuda-.*/\1/')"
    else
        log_status "use cuda: cuda $target (no cudnn for cuda-$cuda_major)"
    fi
}

use_optix() {
    local base="${CUDA_ROOT:-$HOME/cuda}"
    local target="${1:-latest}"

    if [[ "$target" == "latest" ]]; then
        local latest_dir
        latest_dir="$(ls -d "$base"/optix-* 2>/dev/null | sort -V | tail -n 1)"
        if [[ -z "$latest_dir" ]]; then
            log_error "use optix: no OptiX SDKs found under $base"
            return 1
        fi
        target="$(basename "$latest_dir" | sed 's/^optix-//')"
    fi

    local optix_dir="$base/optix-$target"
    if [[ ! -d "$optix_dir" ]]; then
        # Allow "7.7" to match "7.7.0": OptiX SDK version dirs carry a patch
        # component but people naturally write just major.minor.
        local alt_dir
        alt_dir="$(ls -d "$base"/optix-"$target".* 2>/dev/null | sort -V | tail -n 1)"
        if [[ -n "$alt_dir" ]]; then
            optix_dir="$alt_dir"
        else
            log_error "use optix: OptiX $target not found under $base"
            return 1
        fi
    fi

    # FindOptiX.cmake honours OptiX_ROOT / OptiX_INSTALL_DIR. The OptiX
    # runtime (libnvoptix.so.1) ships with the NVIDIA driver, so there is no
    # SDK lib dir worth putting on LD_LIBRARY_PATH (9.x ships a bundled GLFW
    # under lib64/ for its own samples — keep that off our paths).
    export OptiX_ROOT="$optix_dir"
    export OptiX_INSTALL_DIR="$optix_dir"
    [[ -d "$optix_dir/include" ]] && path_add CPATH "$optix_dir/include"

    log_status "use optix: optix $target"
}

layout_uv() {
    if [[ -d ".venv" ]]; then
        VIRTUAL_ENV="$(pwd)/.venv"
    fi

    if [[ -z $VIRTUAL_ENV || ! -d $VIRTUAL_ENV ]]; then
        log_status "No virtual environment exists. Executing \`uv venv\` to create one."
        uv venv
        VIRTUAL_ENV="$(pwd)/.venv"
    fi

    if [ -d ".venv/bin" ]; then
        PATH_add .venv/bin
    elif [ -d ".venv/Scripts" ]; then
        PATH_add .venv/Scripts
    fi
    export UV_ACTIVE=1  # or VENV_ACTIVE=1
    export VIRTUAL_ENV
}
